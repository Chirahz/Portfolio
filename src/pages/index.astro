---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PenArrow from '../components/PenArrow.astro';
import { projects, platformLabel, projectHref } from '../data/projects';

// The exact hero file each case page shows, so hovering a card can warm it up
// and the image morph never lands on an empty frame.
const heroSrc = Object.fromEntries(await Promise.all(projects.filter((p) => p.live).map(async (p) =>
  [p.slug, (await getImage({ src: p.image, width: 1920, format: 'webp' })).src])));

// Finished case studies lead; the rest follow as "in progress".
const ordered = [...projects.filter((p) => p.live), ...projects.filter((p) => !p.live)];
const liveCount = projects.filter((p) => p.live).length;
const ph = (t: string) => (t.trim().startsWith('[') ? 'ph' : undefined);
---
<Base footer={false}>
  <div class="landing wrap">
    <section class="head" aria-labelledby="hl">
      <h1 id="hl">
        Designing money<br />
        that works for <span class="circled">everyone.<svg class="ring" viewBox="0 0 270 66" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M139 5.5C84 4.2 21 8 6.2 27.8c-9 12.4 14 28 70 31.6 47 3 113 2.6 157-5.2 26-4.6 37-13.3 32.3-23.5C258.3 15.6 216 6.6 160.6 4.4 136 3.5 112 4 96 6.4"/></svg></span>
      </h1>
      <p class="note hand">
        <svg class="note-arrow" width="16" height="30" viewBox="0 0 16 30" fill="none" aria-hidden="true">
          <path class="shaft" pathLength="1" d="M8.4 28.6c-.5-4.6-.3-9.4-.2-14.1.1-3.2.1-6.4-.1-9.6" />
          <path class="tip" pathLength="1" d="M2.6 10.6C4.4 8.4 6.2 6.2 8 3.6c1.7 2.4 3.5 4.6 5.4 6.8" />
        </svg>
        <span class="note-text">especially the unbanked</span>
      </p>
    </section>

    <div class="intro-col">
      <p class="intro"><span>Senior UX designer and researcher with</span> <span>8+&nbsp;years advancing financial inclusion</span> <span>through digital financial products.</span></p>
      <p class="proof">Now at <strong>KCB Bank Group</strong> · before that M-Pesa Africa and Twiga&nbsp;Foods</p>
    </div>

    <section class="work" id="work" aria-labelledby="work-title">
      <div class="toolbar">
        <p class="work-label"><span class="hand" id="work-title">selected work</span>
          <span class="work-count">{liveCount} case {liveCount === 1 ? 'study' : 'studies'} · {projects.length - liveCount} in progress</span></p>
        <div class="controls">
          <p class="counter" aria-live="polite">
            <span><span data-range>1–2</span> of {projects.length}</span>
            <svg class="progress" viewBox="0 0 72 6" preserveAspectRatio="none" aria-hidden="true"><path class="track" d="M1 3.4C20 2.4 46 2.2 71 3" /><path class="fill" data-progress pathLength="1" d="M1 3.4C20 2.4 46 2.2 71 3" /></svg>
          </p>
          <button type="button" class="arrow" data-prev aria-label="Previous projects" aria-disabled="true"><PenArrow direction="w" size={16} /></button>
          <button type="button" class="arrow" data-next aria-label="Next projects"><PenArrow direction="e" size={16} /></button>
        </div>
      </div>

      <ul class="rail" data-rail>
        {ordered.map((p, i) => {
          const href = projectHref(p);
          const Tag = href ? 'a' : 'div';
          return (
            <li class:list={['card', { 'card--wip': !href }]} style={`--i:${i}`}>
              <Tag class="card-hit" href={href ?? undefined} data-hero={heroSrc[p.slug]} data-cursor={href ? 'View case' : 'Write-up soon'}>
                <div class="card-top">
                  <h3>{p.title}{!href && <span class="visually-hidden"> (case study in progress)</span>}</h3>
                  {href
                    ? <span class="cta">Read the case <PenArrow /></span>
                    : <span class="wip hand" aria-hidden="true">in progress</span>}
                </div>
                <!-- the detail opens on hover/focus; the photo gives up exactly that much height -->
                <div class="more"><div>
                  <p class="line">{p.line}</p>
                  <p class="meta">{platformLabel[p.platform]} · {p.field} · <span class={ph(p.role)}>{p.role}</span> · <span class={ph(p.year)}>{p.year}</span></p>
                </div></div>
                <div class="frame">
                  <Image src={p.image} alt={p.alt} widths={[400, 800]} sizes="(max-width: 720px) 78vw, 395px"
                    loading={i < 4 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>

    </section>
  </div>
  <div class="cursor" data-cursor-pill aria-hidden="true"><span data-cursor-text>View case</span><PenArrow /></div>
</Base>

<script>
  import { onPage, reducedMotion } from '../scripts/page';
  onPage((signal) => {
    const rail = document.querySelector<HTMLUListElement>('[data-rail]');
    if (!rail) return;
    const prev = document.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = document.querySelector<HTMLButtonElement>('[data-next]')!;
    const rangeEl = document.querySelector('[data-range]')!;
    const progress = document.querySelector<SVGPathElement>('[data-progress]');
    const cards = [...rail.querySelectorAll<HTMLLIElement>('.card')];
    const behavior = (): ScrollBehavior => (reducedMotion() ? 'auto' : 'smooth');

    // ---- positions: where each card starts, in rail scroll coordinates ----
    const pad = () => parseFloat(getComputedStyle(rail).paddingLeft);
    const maxScroll = () => rail.scrollWidth - rail.clientWidth;
    const starts = () => {
      const r0 = rail.getBoundingClientRect().left - rail.scrollLeft + pad();
      return cards.map((c) => Math.min(maxScroll(), Math.max(0, c.getBoundingClientRect().left - r0)));
    };
    const visibleRange = () => {
      const r = rail.getBoundingClientRect();
      const left = r.left + pad() - 2, right = r.right - pad() + 2;
      const vis = cards.map((c) => { const b = c.getBoundingClientRect(); return b.left >= left && b.right <= right; });
      let first = vis.indexOf(true), last = vis.lastIndexOf(true);
      if (first < 0) { first = last = 0; }
      return { first, last };
    };

    function update() {
      const { first, last } = visibleRange();
      rangeEl.textContent = first === last ? `${first + 1}` : `${first + 1}–${last + 1}`;
      const max = maxScroll();
      const p = max > 0 ? rail.scrollLeft / max : 1;
      if (progress) progress.style.strokeDashoffset = String(1.02 - Math.max(0.06, p) * 1.02);
      prev.setAttribute('aria-disabled', String(rail.scrollLeft <= 4));
      next.setAttribute('aria-disabled', String(rail.scrollLeft >= max - 4));
    }

    // next: bring the first card that isn't fully visible to the start; prev: step back a page
    next.addEventListener('click', () => {
      if (next.getAttribute('aria-disabled') === 'true') return;
      const { last } = visibleRange();
      const s = starts();
      rail.scrollTo({ left: s[Math.min(cards.length - 1, last + 1)], behavior: behavior() });
    });
    prev.addEventListener('click', () => {
      if (prev.getAttribute('aria-disabled') === 'true') return;
      // go back about one view, landing on the card start nearest to that point
      const s = starts();
      const want = Math.max(0, rail.scrollLeft - (rail.clientWidth - 2 * pad()));
      let target = s.reduce((best, x) => (Math.abs(x - want) < Math.abs(best - want) ? x : best), s[0]);
      if (target >= rail.scrollLeft - 2) target = [...s].reverse().find((x) => x < rail.scrollLeft - 2) ?? 0;
      rail.scrollTo({ left: target, behavior: behavior() });
    });

    let raf = 0;
    rail.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update, { signal });

    // ---- mouse drag with momentum (touch & trackpads scroll natively) ----
    let dragging = false, moved = false, startX = 0, startLeft = 0;
    let samples: { x: number; t: number }[] = [];
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true; moved = false; startX = e.clientX; startLeft = rail.scrollLeft;
      samples = [{ x: e.clientX, t: e.timeStamp }];
    });
    addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 8) { moved = true; rail.classList.add('is-dragging'); setCursor('Drag'); }
      if (!moved) return;
      rail.scrollLeft = startLeft - dx;
      samples.push({ x: e.clientX, t: e.timeStamp });
      if (samples.length > 8) samples.shift();
    }, { signal });
    addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      if (!moved) return;
      rail.classList.remove('is-dragging');
      setCursor(null);
      // velocity over the last ~100ms, projected forward, then settle on the nearest card start
      const recent = samples.filter((s) => e.timeStamp - s.t <= 100);
      const a = recent[0], b = recent[recent.length - 1];
      const v = a && b && b.t > a.t ? (b.x - a.x) / (b.t - a.t) : 0;   // px/ms, + = dragged right
      const projected = rail.scrollLeft - v * 320;
      const s = starts();
      const target = s.reduce((best, x) => (Math.abs(x - projected) < Math.abs(best - projected) ? x : best), s[0]);
      rail.scrollTo({ left: target, behavior: behavior() });
    }, { signal });
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    rail.addEventListener('dragstart', (e) => e.preventDefault());

    // Arrow keys move between cards
    rail.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const items = cards.map((c) => c.querySelector<HTMLElement>('.card-hit')).filter((el): el is HTMLElement => !!el && el.tagName === 'A');
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      const n = items[i + (e.key === 'ArrowRight' ? 1 : -1)];
      if (n) { e.preventDefault(); n.focus(); }
    });

    update();

    // ---- "View case" label that follows the pointer over a live card ----
    const pill = document.querySelector<HTMLElement>('[data-cursor-pill]');
    const pillText = document.querySelector<HTMLElement>('[data-cursor-text]');
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let tx = 0, ty = 0, cx = 0, cy = 0, follow = 0, label: string | null = null;
    const setCursor = (text: string | null) => {
      label = text;
      if (!pill || !pillText) return;
      if (text) pillText.textContent = text;
      pill.classList.toggle('is-on', !!text);
      pill.classList.toggle('is-drag', text !== 'View case');   // the arrow only when there's somewhere to go
    };
    const loop = () => {
      // ease toward the pointer: 1:1 feels glued on, this trails by a hair like a pen
      cx += (tx - cx) * 0.3; cy += (ty - cy) * 0.3;
      if (pill) pill.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0)`;
      follow = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.3 ? requestAnimationFrame(loop) : 0;
    };
    if (fine && pill) {
      rail.addEventListener('pointermove', (e) => {
        tx = e.clientX; ty = e.clientY;
        if (!label) { cx = tx; cy = ty; }
        if (!dragging) {
          const hit = (e.target as HTMLElement).closest<HTMLElement>('[data-cursor]');
          setCursor(hit ? hit.dataset.cursor! : null);
        }
        if (!follow) follow = requestAnimationFrame(loop);
      });
      rail.addEventListener('pointerleave', () => { if (!dragging) setCursor(null); });
      signal.addEventListener('abort', () => cancelAnimationFrame(follow));
    }

    // warm the case hero as soon as a card shows intent (hover, focus or touch)
    const warmed = new Set<string>();
    const warm = (e: Event) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-hero]');
      const src = a?.dataset.hero;
      if (!src || warmed.has(src)) return;
      warmed.add(src);
      const im = new Image(); im.decoding = 'async'; im.src = src;
    };
    rail.addEventListener('pointerover', warm);
    rail.addEventListener('focusin', warm);
    rail.addEventListener('touchstart', warm, { passive: true });

    // Pen loop: only runs while the headline is on screen and the tab is visible
    const head = document.querySelector<HTMLElement>('.head')!;
    let onScreen = true;
    const sync = () => head.classList.toggle('is-paused', !onScreen || document.hidden);
    const io = new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; sync(); });
    io.observe(head);
    signal.addEventListener('abort', () => io.disconnect());
    document.addEventListener('visibilitychange', sync, { signal });
  });
</script>

<style>
  /* ---------- Layout ---------- */
  .landing {
    display: grid;
    grid-template-columns: var(--col) var(--col) minmax(0, 1fr);
    column-gap: var(--gap);
    grid-template-areas:
      "head head intro"
      "work work work";
    padding-top: 28px;
    padding-bottom: 48px;
  }
  .head { grid-area: head; }
  .intro-col { grid-area: intro; justify-self: end; width: max-content; max-width: 100%; }
  .work { grid-area: work; min-width: 0; }

  /* ---------- Headline ---------- */
  h1 {
    margin: 0;
    font-size: clamp(40px, 4.2vw, 60px);
    line-height: 0.96;
    font-weight: 420;
    letter-spacing: -0.025em;
    font-variation-settings: 'opsz' 72;
  }
  .circled { position: relative; display: inline-block; margin-left: 0.36em; white-space: nowrap; }
  .ring {
    position: absolute; left: -0.24em; top: -0.1em;
    width: calc(100% + 0.54em); height: calc(100% + 0.24em); max-width: none;
    overflow: visible; pointer-events: none;
  }
  .ring path {
    fill: none; stroke: var(--pen); stroke-width: 2.4; stroke-linecap: round;
    stroke-dasharray: 1 2; stroke-dashoffset: 1.02;
  }

  .note {
    margin: 8px 0 0;
    padding-left: calc(clamp(40px, 4.2vw, 60px) * 6.5);
    font-size: 26px; line-height: 1;
    display: flex; align-items: flex-end; gap: 4px;
  }
  .note-arrow { flex: none; margin-bottom: 2px; overflow: visible; }
  .note-arrow path { stroke: var(--pen); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 2; stroke-dashoffset: 1.02; }
  .note-text { display: inline-block; padding: 0 4px 4px 0; clip-path: inset(0 100% 0 0); }

  /*
    The pen loop — one 6s cycle on a single clock, starting the moment the page paints:
    0–0.6s     circle drawn round "everyone."
    0.36–0.78s arrow drawn upward while the circle closes, then its tip
    0.72–1.56s note written left to right
    1.56–4.3s  hold so it can be read
    4.3–4.56s  arrow + note lift off
    4.5–5.04s  circle erased in the direction it was drawn
    5.04–6s    a short breath on the clean headline, then again
  */
  .ring path      { animation: ring-loop 6s infinite both; }
  /* once the circle closes it gives one small press: out 4.5%, then settles back */
  .ring           { transform-origin: 50% 50%; animation: ring-pulse 6s infinite both; }
  .note .shaft    { animation: shaft-loop 6s infinite both; }
  .note .tip      { animation: tip-loop 6s infinite both; }
  .note-text      { animation: write-loop 6s infinite both; }
  .head.is-paused :is(.ring, .ring path, .shaft, .tip, .note-text) { animation-play-state: paused; }

  @keyframes ring-pulse {
    0%, 9.5% { transform: scale(1); animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    12.5%    { transform: scale(1.045); animation-timing-function: cubic-bezier(0.32, 0.72, 0, 1); }
    17.5%, 100% { transform: scale(1); }
  }

  @keyframes ring-loop {
    0%   { stroke-dashoffset: 1.02; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
    10%  { stroke-dashoffset: 0; }
    75%  { stroke-dashoffset: 0; animation-timing-function: cubic-bezier(0.32, 0.72, 0, 1); }
    84%, 100% { stroke-dashoffset: -1.02; }
  }
  @keyframes shaft-loop {
    0%, 6% { stroke-dashoffset: 1.02; opacity: 1; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    11%  { stroke-dashoffset: 0; }
    72%  { stroke-dashoffset: 0; opacity: 1; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    76%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes tip-loop {
    0%, 10% { stroke-dashoffset: 1.02; opacity: 1; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    13%  { stroke-dashoffset: 0; }
    72%  { stroke-dashoffset: 0; opacity: 1; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    76%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes write-loop {
    0%, 12% { clip-path: inset(0 100% 0 0); opacity: 1; transform: none; animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1); }
    26%  { clip-path: inset(0 0 0 0); }
    72%  { clip-path: inset(0 0 0 0); opacity: 1; transform: none; animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1); }
    76%, 100% { clip-path: inset(0 0 0 0); opacity: 0; transform: translateY(-3px); }
  }

  /* the intro's longest line ends on the same right edge as the theme switch and the arrows */
  .intro {
    margin: 6px 0 0;
    justify-self: end; width: max-content; max-width: 100%;
    font-size: 20px; line-height: 29px; color: var(--ink);
  }
  .intro span { display: block; }
  /* narrower desktops: let the three lines re-wrap naturally inside the column */
  @media (max-width: 1380px) { .intro-col, .intro { width: auto; } .intro span { display: inline; } }
  /* real places, real roles: proof sits right under who you are, sized to the intro's width */
  .proof { width: 0; min-width: 100%; margin: 14px 0 0; font-size: 15px; line-height: 22px; color: var(--pencil); }
  .proof strong { color: var(--ink); font-weight: 560; }
  /* ---------- Toolbar ---------- */
  .toolbar {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    margin-top: 20px; min-height: 48px;
  }
  .work-label { margin: 0; display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .work-label .hand { font-size: 28px; line-height: 1; }
  .work-count { font-size: 15px; color: var(--pencil); }

  .controls { display: flex; align-items: center; gap: 0; margin-right: -8px; }
  .counter { margin: 0 12px 0 0; display: grid; justify-items: end; gap: 2px; font-size: 15px; color: var(--pencil); font-variant-numeric: tabular-nums; }
  .progress { width: 72px; height: 6px; overflow: visible; }
  .progress path { fill: none; stroke-width: 2; stroke-linecap: round; }
  .progress .track { stroke: var(--rule-strong); }
  .progress .fill { stroke: var(--pen); stroke-dasharray: 1 2; stroke-dashoffset: 0.95; transition: stroke-dashoffset 260ms var(--ease-ui); }
  .arrow {
    width: 48px; height: 48px; display: grid; place-items: center; cursor: pointer;
    border: 0; background: none; border-radius: 999px; position: relative; color: var(--ink);
    transition: opacity 150ms var(--ease-ui), transform 160ms var(--ease-ui);
  }
  .arrow::before {
    content: ''; position: absolute; inset: 8px; border-radius: 999px;
    box-shadow: inset 0 0 0 1.25px currentColor; transition: background 150ms var(--ease-ui);
  }
  .arrow :global(svg) { position: relative; }
  .arrow[aria-disabled="true"] { opacity: 0.35; cursor: default; }
  .arrow:not([aria-disabled="true"]):active { transform: scale(0.94); }
  @media (hover: hover) and (pointer: fine) { .arrow:not([aria-disabled="true"]):hover::before { background: var(--lift); } }

  /* ---------- Rail ---------- */
  /* photo height fits the page to one screen on common laptops, and grows on taller ones */
  /* the photos take whatever height is left on one screen (the toolbar and closing row are gone
     from below the rail), up to roughly square on tall screens */
  .landing { --frame-h: clamp(200px, calc(100svh - 552px), calc(var(--col) * 0.96)); padding-bottom: 12px; }
  @media (max-width: 1380px) and (min-width: 1101px) {
    /* smaller laptops: a slightly smaller intro keeps it to three lines, so the photos keep their height */
    .landing { --frame-h: clamp(200px, calc(100svh - 556px), calc(var(--col) * 0.96)); }
    .intro { font-size: 18px; line-height: 27px; }
    .proof { font-size: 14px; line-height: 21px; margin-top: 10px; }
  }
  .rail {
    list-style: none; margin: 4px calc(-1 * var(--gutter)) 0; padding: 12px var(--gutter) 20px;
    display: flex; gap: var(--gap);
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail.is-dragging { scroll-snap-type: none; cursor: grabbing; }
  .rail.is-dragging .card-hit { pointer-events: none; }

  .card { position: relative; z-index: 0; flex: 0 0 var(--col); scroll-snap-align: start; }
  @media (min-width: 1101px) {
    /* let the last page of cards line up with the left column */
    .card:last-child { margin-right: max(0px, calc(100vw - 2 * var(--gutter) - 3 * var(--col) - 2 * var(--gap))); }
  }
  .card-hit { position: relative; display: block; text-decoration: none; color: inherit; border-radius: 18px; }
  .card-hit:focus-visible { outline: none; }

  /* the hover lift: a paper panel 12px proud of the card */
  .card-hit::before {
    content: ''; position: absolute; inset: -12px; z-index: -1;
    background: var(--lift); border-radius: 18px; box-shadow: var(--shadow-lift);
    opacity: 0; transform: scale(0.985);
    transition: opacity 200ms var(--ease-ui), transform 260ms var(--ease-ui);
  }

  /* every card is the same box: title + photo at rest; the detail slides open on hover and the
     photo shrinks by exactly that much, so the card never changes size */
  .card-hit { display: flex; flex-direction: column; height: calc(var(--frame-h) + 116px); }
  .card-top { flex: none; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; height: 28px; }
  h3 { margin: 0; min-width: 0; font-size: 22px; line-height: 28px; font-weight: 560; letter-spacing: -0.01em; font-variation-settings: 'opsz' 24; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .more {
    flex: none; display: grid; grid-template-rows: 0fr; opacity: 0;
    transition: grid-template-rows 460ms cubic-bezier(0.77, 0, 0.175, 1), opacity 220ms var(--ease-ui);
  }
  .more > div { min-height: 0; overflow: hidden; }
  .line {
    margin: 6px 0 0; font-size: 16px; line-height: 23px; height: 46px; color: var(--ink); max-width: 46ch;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .meta { margin: 6px 0 0; font-size: 14px; line-height: 20px; color: var(--pencil); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ph { color: var(--pencil); opacity: 0.85; }
  .card--wip .line { color: var(--pencil); }
  .card-hit:focus-visible .more { grid-template-rows: 1fr; opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    .card-hit:hover .more { grid-template-rows: 1fr; opacity: 1; transition-delay: 40ms, 140ms; }
  }
