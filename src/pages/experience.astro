---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PenArrow from '../components/PenArrow.astro';
import { site } from '../data/site';
import { photo, why, highlights, roles, practice, domains, credentials } from '../data/experience';
// Text still in [brackets] is a placeholder — shown in pencil grey until it's filled in.
const ph = (t: string) => (t.trim().startsWith('[') ? 'ph' : undefined);
const titleWords = ['Eight', 'years', 'designing', '\n', 'digital', 'money', 'in', 'Kenya.'];
let wi = 0;
---
<Base title="Experience" description="Eight years designing digital money in Kenya — why, highlights, roles, practice and credentials.">
  <div class="exp wrap">

    <!-- ---------- Hero ---------- -->
    <header class="top">
      <div class="top-text">
        <p class="hand kicker">experience</p>
        <h1 aria-label="Eight years designing digital money in Kenya.">
          {titleWords.map((w) => w === '\n'
            ? <br class="br-d" />
            : <span class="w" aria-hidden="true"><span style={`--i:${wi++}`}>{w === 'in' ? 'in' : w}</span></span>)}
        </h1>
        <p class="lede rise" style="--d: 0.62s">Senior UX designer and researcher with 8+&nbsp;years advancing financial inclusion through digital financial products, from mobile money to banking apps and the platforms behind them.</p>
        <div class="actions rise" style="--d: 0.74s">
          {site.cv
            ? <a class="btn" href={site.cv} download>Download CV <PenArrow /></a>
            : <button type="button" class="btn" data-open-contact>Ask for my CV <PenArrow /></button>}
          <a class="link plain" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn <PenArrow /></a>
        </div>
      </div>
      <figure class="photo">
        <span class="tape tape-l" aria-hidden="true"></span>
        <span class="tape tape-r" aria-hidden="true"></span>
        {photo
          ? <Image src={photo} alt="CJ at work" widths={[440, 880]} sizes="(max-width: 720px) 300px, 440px" loading="eager" />
          : <div class="photo-ph" role="img" aria-label="Photo placeholder">
              <span>[Your photo]</span>
              <small>Portrait, ideally at work · 880 × 1080 or larger</small>
            </div>}
      </figure>
    </header>

    <!-- ---------- Why ---------- -->
    <section class="sec" data-reveal aria-labelledby="h-why">
      <div class="side"><h2 id="h-why" class="hand label">why this work</h2></div>
      <p class="statement">{why}</p>
    </section>

    <!-- ---------- Highlights ---------- -->
    <section class="sec" data-reveal aria-labelledby="h-hi">
      <div class="side">
        <h2 id="h-hi" class="hand label">highlights</h2>
        <p class="side-note">In short</p>
      </div>
      <dl class="highlights">
        {highlights.map((h, i) => (
          <div style={`--i:${i}`}>
            <dt class={ph(h.label)}>{h.label}</dt>
            <dd class={ph(h.value)}>{h.value}<svg class="uline" viewBox="0 0 120 8" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 5.4C30 3.2 72 2.6 118 4.2" /></svg></dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ---------- Timeline ---------- -->
    <section class="sec" aria-labelledby="h-roles">
      <div class="side" data-reveal>
        <h2 id="h-roles" class="hand label">where I've worked</h2>
        <p class="side-note">Roles, newest first</p>
      </div>
      <div class="timeline" data-timeline>
        <span class="spine" aria-hidden="true"><span class="ink" data-ink></span></span>
        <ol class="roles">
          {roles.map((r) => (
            <li class="role" data-reveal data-role>
              <span class="dot" aria-hidden="true"></span>
              <div class="role-head">
                <h3 class={ph(r.title)}>{r.title}</h3>
                <p class:list={['dates', ph(r.dates)]}>{r.dates}</p>
              </div>
              <p class="org">{r.org}</p>
              <ul class="points">
                {r.points.map((pt) => <li class={ph(pt)}>{pt}</li>)}
              </ul>
              {r.tags && <p class="tags">{r.tags.join(' · ')}</p>}
              {r.link && <a class="more link" href={r.link.href}>{r.link.label} <PenArrow /></a>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ---------- Practice ---------- -->
    <section class="sec" data-reveal aria-labelledby="h-do">
      <div class="side">
        <h2 id="h-do" class="hand label">what I do</h2>
        <p class="side-note">Where I add most value</p>
      </div>
      <div>
        <ul class="practice">
          {practice.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p class:list={['p-body', ph(p.body)]}>{p.body}</p>
              <p class:list={['methods', ph(p.methods)]}>{p.methods}</p>
            </li>
          ))}
        </ul>
        <div class="domains">
          <p class="domains-label">Domains</p>
          <ul>{domains.map((d) => <li>{d}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- ---------- Credentials ---------- -->
    <section class="sec" data-reveal aria-labelledby="h-cred">
      <div class="side">
        <h2 id="h-cred" class="hand label">credentials</h2>
        <p class="side-note">Education and certifications</p>
      </div>
      <ul class="creds">
        {credentials.map((c) => <li><span>{c.name}</span><span class:list={['from', ph(c.from)]}>{c.from}</span></li>)}
      </ul>
    </section>

    <aside class="next" data-reveal aria-labelledby="h-next">
      <div>
        <p class="hand next-label">next</p>
        <h2 id="h-next">See the work</h2>
        <p class="next-sub">Six projects across payments, transport, onboarding and research.</p>
      </div>
      <div class="next-actions">
        <a class="btn" href="/#work">Selected work <PenArrow /></a>
        <button type="button" class="link plain" data-open-contact>Get in touch <PenArrow /></button>
      </div>
    </aside>
  </div>
</Base>

<script>
  import { onPage, reducedMotion } from '../scripts/page';
  onPage((signal) => {
    const page = document.querySelector('.exp');
    if (!page) return;

    // Sections ease up as they come into view. Anything already above the fold
    // (End key, fast flick, anchor jump) is revealed too, so nothing is left hidden.
    let pending = [...page.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reveal = () => {
      if (!pending.length) return;
      const edge = innerHeight * 0.9;
      pending = pending.filter((el) => {
        if (el.getBoundingClientRect().top < edge) { el.classList.add('is-in'); return false; }
        return true;
      });
    };

    // The timeline: a pen line draws down the spine as you scroll; each role's dot inks
    // when the line reaches it. One transform per frame, nothing else.
    const tl = page.querySelector<HTMLElement>('[data-timeline]');
    const ink = page.querySelector<HTMLElement>('[data-ink]');
    const dots = [...page.querySelectorAll<HTMLElement>('[data-role]')];
    const drawLine = () => {
      if (!tl || !ink) return;
      if (reducedMotion()) { ink.style.transform = 'scaleY(1)'; dots.forEach((d) => d.classList.add('is-inked')); return; }
      const r = tl.getBoundingClientRect();
      const pen = innerHeight * 0.62;                 // the pen sits a little below mid-screen
      const p = Math.min(1, Math.max(0, (pen - r.top) / r.height));
      ink.style.transform = `scaleY(${p.toFixed(4)})`;
      const reach = r.top + p * r.height;
      dots.forEach((d) => d.classList.toggle('is-inked', d.getBoundingClientRect().top + 14 <= reach + 1));
    };

    let raf = 0;
    const tick = () => { raf = 0; reveal(); drawLine(); };
    const queue = () => { if (!raf) raf = requestAnimationFrame(tick); };
    tick();
    addEventListener('scroll', queue, { passive: true, signal });
    addEventListener('resize', queue, { signal });
    signal.addEventListener('abort', () => cancelAnimationFrame(raf));
  });
</script>

<style>
  .exp { padding-top: 56px; padding-bottom: 128px; }

  /* ---------- Hero ---------- */
  .top { display: grid; grid-template-columns: minmax(0, 1fr) 440px; gap: 96px; align-items: center; }
  .kicker { margin: 0 0 16px; font-size: 28px; line-height: 1; }
  h1 {
    margin: 0; font-size: clamp(44px, 4.6vw, 66px); line-height: 1.02; font-weight: 420;
    letter-spacing: -0.025em; font-variation-settings: 'opsz' 96;
  }
  /* each word rises out of its own line box (same move as the case title) */
  h1 .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.1em; margin-bottom: -0.1em; margin-right: 0.24em; }
  h1 .w:last-child { margin-right: 0; }
  h1 .w > span { display: inline-block; transform: translateY(108%); animation: word-rise 0.95s var(--ease-focal) both; animation-delay: calc(0.3s + var(--i) * 0.06s); }
  @keyframes word-rise { to { transform: none; } }

  .lede { margin: 24px 0 0; font-size: 19px; line-height: 1.6; max-width: 620px; }
  .actions { display: flex; align-items: center; gap: 32px; margin-top: 36px; flex-wrap: wrap; }
  .rise { animation: soft-rise 0.8s var(--ease-focal) both; animation-delay: var(--d, 0.6s); }
  @keyframes soft-rise { from { opacity: 0; transform: translate3d(0, 14px, 0); } }

  /* matches the "Button / Ink CTA — Fraunces" component: square-cornered ink block */
  .btn {
    display: inline-flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 28px;
    border: 0; border-radius: 2px; background: var(--ink); color: var(--paper);
    font-size: 16px; font-weight: 560; text-decoration: none; cursor: pointer;
    transition: transform 160ms var(--ease-ui), opacity 150ms var(--ease-ui);
  }
  .btn:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .btn:hover { opacity: 0.88; } }
  .plain {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px;
    font-size: 16px; font-weight: 560; color: var(--ink); background-color: transparent; border: 0; padding: 0; cursor: pointer;
    --pen-y: calc(100% - 6px);
  }

  /* the photo settles onto the page, then the tape goes on */
  .photo { position: relative; margin: 0; animation: settle 1s var(--ease-focal) 0.4s both; transform-origin: 50% 0; }
  @keyframes settle { from { opacity: 0; transform: translate3d(0, 18px, 0) rotate(-2.4deg) scale(0.985); } }
  .photo :global(img), .photo-ph {
    display: block; width: 100%; height: auto; aspect-ratio: 440 / 540; object-fit: cover;
    background: var(--placeholder); border-radius: 4px;
    box-shadow: 0 1px 2px rgba(60, 45, 20, 0.08);
  }
  .photo-ph { display: grid; place-content: center; gap: 8px; text-align: center; padding: 24px; color: var(--pencil); }
  .photo-ph span { font-size: 22px; }
  .photo-ph small { font-size: 14px; }
  .tape {
    position: absolute; z-index: 1; width: 86px; height: 26px;
    background: rgba(238, 217, 138, 0.8); mix-blend-mode: multiply;
    transform-origin: 0 50%;
    animation: tape-on 0.34s var(--ease-ui) both;
  }
  :global([data-theme="dark"]) .tape { mix-blend-mode: normal; opacity: 0.7; }
  .tape-l { left: -22px; top: 6px; rotate: -24deg; animation-delay: 1.15s; }
  .tape-r { right: -26px; top: -6px; rotate: -22deg; animation-delay: 1.28s; }
  @keyframes tape-on { from { scale: 0.2 1; opacity: 0; } }

  /* ---------- Sections: label sticks in the margin while its section scrolls past ---------- */
  .sec {
    display: grid; grid-template-columns: 296px minmax(0, 1fr); column-gap: 112px;
    margin-top: 160px;
  }
  .side { position: sticky; top: 40px; align-self: start; padding-top: 4px; }
  .label {
    margin: 0; font-size: 30px; line-height: 1.1; font-weight: 500;
    /* written in left to right when its section arrives */
    clip-path: inset(-10% 100% -10% 0);
    transition: clip-path 0.9s cubic-bezier(0.37, 0, 0.63, 1) 0.15s;
  }
  :global(.is-in) .label, .is-in.side .label { clip-path: inset(-10% -4% -10% 0); }
  .side-note { margin: 10px 0 0; font-size: 15px; color: var(--pencil); }

  /* why */
  .statement {
    margin: 0; max-width: 22em;
    font-size: clamp(30px, 3vw, 44px); line-height: 1.28; letter-spacing: -0.018em;
    font-variation-settings: 'opsz' 72;
  }

  /* highlights */
  .highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin: 0; }
  .highlights div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .highlights dd {
    position: relative; margin: 0; align-self: flex-start;
    font-size: clamp(40px, 3.6vw, 56px); line-height: 1.05; letter-spacing: -0.025em; font-variation-settings: 'opsz' 96;
    padding-bottom: 10px;
  }
  .highlights dt { margin-top: 12px; font-size: 17px; line-height: 1.5; color: var(--pencil); max-width: 30ch; }
  .uline { position: absolute; left: 0; bottom: 0; width: 100%; height: 8px; overflow: visible; }
  .uline path { fill: none; stroke: var(--pen); stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 1 2; stroke-dashoffset: 1.02; }
  .is-in .uline path { stroke-dashoffset: 0; transition: stroke-dashoffset 0.7s var(--ease-focal); transition-delay: calc(0.35s + var(--i) * 0.14s); }
  .highlights dd.ph .uline { display: none; }

  /* timeline */
  .timeline { position: relative; padding-left: 40px; }
  .spine { position: absolute; left: 6px; top: 12px; bottom: 0; width: 2px; background: var(--rule-strong); border-radius: 2px; }
  .ink { position: absolute; inset: 0; background: var(--pen); border-radius: 2px; transform: scaleY(0); transform-origin: 50% 0; will-change: transform; }
  .roles { list-style: none; margin: 0; padding: 0; }
  .role { position: relative; padding-bottom: 72px; }
  .role:last-child { padding-bottom: 8px; }
  .dot {
    position: absolute; left: -40px; top: 10px; width: 14px; height: 14px; border-radius: 50%;
    background: var(--paper); box-shadow: inset 0 0 0 2px var(--rule-strong);
    transition: box-shadow 260ms var(--ease-ui), background-color 260ms var(--ease-ui), transform 360ms var(--ease-focal);
  }
  .role.is-inked .dot { background: var(--pen); box-shadow: inset 0 0 0 2px var(--pen), 0 0 0 5px color-mix(in srgb, var(--pen) 14%, transparent); transform: scale(1.08); }
  .role-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px 24px; flex-wrap: wrap; }
  h3 { margin: 0; font-size: 28px; line-height: 1.25; font-weight: 450; letter-spacing: -0.012em; font-variation-settings: 'opsz' 36; }
  .dates { margin: 0; font-size: 15px; color: var(--pencil); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .org { margin: 4px 0 0; font-size: 17px; color: var(--pen); }
  .points { list-style: none; margin: 14px 0 0; padding: 0; max-width: 64ch; }
  .points li { position: relative; padding-left: 22px; margin-top: 8px; font-size: 18px; line-height: 1.55; }
  .points li::before { content: ''; position: absolute; left: 0; top: 0.78em; width: 10px; height: 2px; border-radius: 2px; background: var(--pencil); opacity: 0.6; }
  .tags { margin: 14px 0 0; font-size: 15px; line-height: 1.6; color: var(--pencil); word-spacing: 0.12em; }
  .more {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; min-height: 44px;
    font-size: 15px; font-weight: 560; color: var(--ink); text-decoration: none;
    --pen-y: calc(100% - 8px);
  }

  /* practice + domains */
  .practice { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .practice h3 { font-size: 22px; min-height: 2.5em; }
  .p-body { margin: 12px 0 0; font-size: 18px; line-height: 1.55; }
  .methods { margin: 12px 0 0; font-size: 15px; line-height: 1.5; color: var(--pencil); }
  .domains { margin-top: 56px; }
  .domains-label { margin: 0 0 12px; font-size: 15px; color: var(--pencil); }
  .domains ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 12px; }
  .domains li { font-size: 17px; padding: 8px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--rule-strong); background: color-mix(in srgb, var(--lift) 60%, transparent); }

  /* credentials */
  .creds { list-style: none; margin: 0; padding: 0; }
  .creds li { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: 0 0 18px; font-size: 20px; }
  .from { font-size: 15px; color: var(--pencil); text-align: right; }

  .next {
    margin-top: 160px; padding: 48px 56px; border-radius: 18px;
    background: var(--lift); box-shadow: var(--shadow-lift);
    display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;
  }
  .next-label { margin: 0; font-size: 26px; line-height: 1; }
  .next h2 { margin: 8px 0 0; font-size: clamp(36px, 3.6vw, 52px); line-height: 1.05; font-weight: 420; letter-spacing: -0.025em; }
  .next-sub { margin: 10px 0 0; color: var(--pencil); font-size: 17px; }
  .next-actions { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }

  .ph { color: var(--pencil); }
  h3.ph { font-weight: 400; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1100px) {
    .top { grid-template-columns: minmax(0, 1fr) 340px; gap: 56px; }
    .sec { grid-template-columns: 200px minmax(0, 1fr); column-gap: 48px; }
    .practice, .highlights { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 720px) {
    .br-d { display: none; }
    .exp { padding-top: 32px; padding-bottom: 96px; }
    .top { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .photo { max-width: 260px; margin-left: 12px; }       /* headline first, photo after */
    .lede { font-size: 18px; }
    .actions { gap: 24px; }
    .sec { grid-template-columns: minmax(0, 1fr); margin-top: 104px; row-gap: 28px; }
    .side { position: static; }
    .statement { font-size: 28px; }
    .timeline { padding-left: 32px; }
    .dot { left: -32px; }
    .role { padding-bottom: 56px; }
    h3 { font-size: 24px; }
    .points li { font-size: 17px; }
    .creds li { flex-direction: column; gap: 2px; font-size: 18px; }
    .from { text-align: left; }
    .next { margin-top: 112px; padding: 32px 24px; flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    h1 .w > span, .rise, .photo, .tape { animation: none; transform: none; }
    .tape-l { rotate: -24deg; } .tape-r { rotate: -22deg; }
    .label { clip-path: none; transition: none; }
    .uline path { stroke-dashoffset: 0; transition: none; }
    .dot { transition: none; }
  }
</style>
