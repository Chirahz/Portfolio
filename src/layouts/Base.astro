---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSheet from '../components/ContactSheet.astro';
import Overview from '../components/Overview.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';

// Page change: the old page lifts away fast, the new one rises in a beat later,
// so the shared project image (see .work-image) gets the stage while it morphs.
const pageAnim = {
  forwards: {
    old: { name: 'page-out', duration: '0.3s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fillMode: 'both' },
    new: { name: 'page-in', duration: '0.7s', delay: '0.26s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'page-out', duration: '0.3s', easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fillMode: 'both' },
    new: { name: 'page-in', duration: '0.7s', delay: '0.26s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
  },
};

interface Props { title?: string; description?: string; footer?: boolean; image?: string }
const { title, description = site.description, footer = true, image } = Astro.props;
const fullTitle = title ? `${title} — CJ` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" transition:animate={pageAnim}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      function apply(doc) {
        doc.documentElement.classList.add('js');
        try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') doc.documentElement.dataset.theme = t; } catch (e) {}
      }
      apply(document);
      // first visit to the home page: start in the zoomed-out overview (skipped for reduced motion)
      try {
        if (location.pathname === '/' && !sessionStorage.getItem('intro-seen') &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro');
        }
      } catch (e) {}
      if (!window.__themeHook) {
        window.__themeHook = true;
        // keep the visitor's theme on the incoming page before it is shown
        document.addEventListener('astro:before-swap', function (e) { apply(e.newDocument); });
      }
    })();
  </script>
  <ClientRouter />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#F7F3EB" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Overview />
  <div class="shell">
    <Header />
    <main id="main"><slot /></main>
    {footer && <Footer />}
  </div>
  <ContactSheet />
  <script>import '../scripts/smooth'; import '../scripts/transitions';</script>
</body>
</html>
