---
import { site } from '../data/site';
import PenArrow from './PenArrow.astro';
---
<dialog id="contact" class="sheet" aria-labelledby="contact-title" data-endpoint={site.formEndpoint} data-email={site.email}>
  <div class="sheet-inner">
    <div class="sheet-head">
      <h2 id="contact-title">Write to me</h2>
      <button type="button" class="close" data-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4.5 4.8c3.6 3.4 7.2 7 11 10.6"/><path d="M15.3 4.6c-3.5 3.6-7.1 7.3-10.7 10.9"/></svg>
      </button>
    </div>

    <form data-state="idle" novalidate>
      <p class="lede">Hiring, collaborating, or curious about a project? A few lines is plenty. I reply within two working days.</p>

      <div class="field">
        <label for="c-name">Your name</label>
        <input id="c-name" name="name" autocomplete="name" required />
        <p class="err hand" id="c-name-err" hidden>↑ I'd love to know who's writing</p>
      </div>
      <div class="field">
        <label for="c-email">Email</label>
        <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required />
        <p class="err hand" id="c-email-err" hidden>↑ that email looks incomplete</p>
      </div>
      <div class="field">
        <label for="c-msg">Message</label>
        <textarea id="c-msg" name="message" rows="5" required></textarea>
        <p class="err hand" id="c-msg-err" hidden>↑ a sentence or two will do</p>
      </div>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />

      <div class="actions">
        <button type="submit" class="send">Send message <PenArrow direction="e" /></button>
        <p class="alt">or email <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>

    <div class="sent" hidden tabindex="-1">
      <p class="hand big">Got it — thank you!</p>
      <p>Your note is on its way. I'll reply within two working days.</p>
      <button type="button" class="send ghost" data-close>Back to the page</button>
    </div>
  </div>
</dialog>

<script>
  import { onPage } from '../scripts/page';
  onPage((signal) => {
    const dlg = document.getElementById('contact') as HTMLDialogElement | null;
    if (dlg) {
      const form = dlg.querySelector('form')!;
      const sent = dlg.querySelector<HTMLElement>('.sent')!;
      const status = dlg.querySelector<HTMLElement>('.form-status')!;
      let opener: HTMLElement | null = null;

      const open = (e?: Event) => {
        opener = (e?.currentTarget as HTMLElement) ?? null;
        form.hidden = false; sent.hidden = true; status.textContent = '';
        dlg.showModal();
        window.lenis?.stop();
        document.documentElement.classList.add('sheet-open');
        requestAnimationFrame(() => dlg.classList.add('is-open'));
        (dlg.querySelector('#c-name') as HTMLInputElement).focus();
      };
      const close = () => {
        dlg.classList.remove('is-open');
        const done = () => { window.lenis?.start(); dlg.close(); document.documentElement.classList.remove('sheet-open'); opener?.focus(); };
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        reduce ? done() : setTimeout(done, 240);
      };

      document.querySelectorAll('[data-open-contact]').forEach((b) => b.addEventListener('click', open));
      dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
      dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
      dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
      if (location.hash === '#contact') open();

      const fields = [
        { el: form.querySelector('#c-name') as HTMLInputElement, ok: (v: string) => v.trim().length > 1 },
        { el: form.querySelector('#c-email') as HTMLInputElement, ok: (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) },
        { el: form.querySelector('#c-msg') as HTMLTextAreaElement, ok: (v: string) => v.trim().length > 9 },
      ];
      const check = (f: typeof fields[number]) => {
        const valid = f.ok(f.el.value);
        const err = document.getElementById(`${f.el.id}-err`)!;
        err.hidden = valid;
        f.el.setAttribute('aria-invalid', String(!valid));
        if (!valid) f.el.setAttribute('aria-describedby', err.id); else f.el.removeAttribute('aria-describedby');
        return valid;
      };
      fields.forEach((f) => f.el.addEventListener('blur', () => { if (f.el.value) check(f); }));
      fields.forEach((f) => f.el.addEventListener('input', () => { if (f.el.getAttribute('aria-invalid') === 'true') check(f); }));

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const results = fields.map(check);
        const firstBad = fields[results.indexOf(false)];
        if (firstBad) { firstBad.el.focus(); return; }
        const data = new FormData(form);
        if (data.get('_gotcha')) return;
        const endpoint = dlg.dataset.endpoint;
        const btn = form.querySelector<HTMLButtonElement>('.send')!;
        if (endpoint) {
          btn.disabled = true; status.textContent = 'Sending…';
          try {
            const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
            if (!res.ok) throw new Error(String(res.status));
          } catch {
            btn.disabled = false;
            status.textContent = `That didn't go through. Please try again, or email ${dlg.dataset.email}.`;
            return;
          }
          btn.disabled = false;
        } else {
          const subject = encodeURIComponent(`Hello from ${data.get('name')}`);
          const body = encodeURIComponent(`${data.get('message')}\n\n— ${data.get('name')} (${data.get('email')})`);
          window.location.href = `mailto:${dlg.dataset.email}?subject=${subject}&body=${body}`;
        }
        form.reset(); form.hidden = true; sent.hidden = false; sent.focus();
      });
    }
  });
</script>

<style>
  .sheet {
    margin: 0 0 0 auto; padding: 0; border: 0; max-width: none; max-height: none;
    width: min(560px, 100vw); height: 100dvh;
    background: var(--lift); color: var(--ink);
    box-shadow: -1px 0 0 var(--rule-strong), -24px 0 48px rgba(40, 30, 10, 0.10);
    transform: translateX(24px); opacity: 0;
    transition: transform 320ms var(--ease-glide), opacity 200ms var(--ease-ui);
    overscroll-behavior: contain;
  }
  .sheet.is-open { transform: none; opacity: 1; }
  .sheet::backdrop { background: var(--scrim); opacity: 0; transition: opacity 240ms var(--ease-ui); }
  .sheet.is-open::backdrop { opacity: 1; }
  :global(html.sheet-open) { overflow: hidden; }

  .sheet-inner { padding: 40px 48px 48px; min-height: 100%; display: flex; flex-direction: column; }
  .sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  h2 { margin: 0; font-size: 40px; font-weight: 400; letter-spacing: -0.02em; line-height: 1.1; }
  .close { width: 48px; height: 48px; display: grid; place-items: center; border: 0; background: none; border-radius: 999px; cursor: pointer; margin-right: -12px; }
  @media (hover: hover) { .close:hover { background: var(--placeholder); } }
  .lede { color: var(--pencil); margin: 0 0 32px; font-size: 17px; }

  .field { margin-bottom: 24px; }
  label { display: block; font-size: 15px; color: var(--pencil); margin-bottom: 6px; }
  input, textarea {
    width: 100%; font: inherit; font-size: 18px; color: var(--ink);
    background: transparent; border: 0; border-bottom: 1.5px solid var(--rule-strong);
    padding: 8px 0; border-radius: 0; resize: vertical;
    transition: border-color 150ms var(--ease-ui);
  }
  textarea {
    line-height: 36px; padding: 0; min-height: 180px;
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 35px, var(--rule-strong) 35px, var(--rule-strong) 36px);
    border-bottom: 0;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--pen); }
  textarea:focus { box-shadow: 0 1.5px 0 var(--pen); }
  [aria-invalid="true"] { border-color: #B4432F; }
  .err { margin: 6px 0 0; font-size: 20px; line-height: 1.2; color: #B4432F; }
  :global([data-theme="dark"]) .err { color: #F0A090; }

  .actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 8px; }
  .send {
    display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 24px;
    border: 0; border-radius: 2px; background: var(--ink); color: var(--paper);
    font-size: 17px; cursor: pointer;
    transition: transform 160ms var(--ease-ui), opacity 150ms;
  }
  .send:active { transform: scale(0.97); }
  .send:disabled { opacity: 0.6; cursor: progress; }
  .send.ghost { background: none; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .alt { margin: 0; font-size: 15px; color: var(--pencil); }
  .form-status { min-height: 1.5em; color: var(--pencil); font-size: 15px; }
  .sent { margin-top: 48px; }
  .sent:focus { outline: none; }
  .big { font-size: 44px; line-height: 1.1; margin: 0 0 16px; }

  @media (max-width: 720px) {
    .sheet { width: 100vw; height: auto; max-height: 92dvh; margin: auto 0 0; border-radius: 20px 20px 0 0; transform: translateY(32px); }
    .sheet-inner { padding: 24px 20px 32px; }
    h2 { font-size: 32px; }
  }
</style>
