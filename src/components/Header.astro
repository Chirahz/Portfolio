---
import { nav } from '../data/site';
---
<header class="site-header wrap">
  <a class="mark" href="/" aria-label="CJ — UX, home">cj.</a>
  <div class="right">
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            {item.contact
              ? <button type="button" class="link" data-open-contact>{item.label}</button>
              : <a class="link" href={item.href}>{item.label}</a>}
          </li>
        ))}
      </ul>
    </nav>
    <button type="button" class="theme" data-theme-toggle aria-label="Switch to dark mode">
      <!-- moon: shown in light mode -->
      <svg class="moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19.6 14.6c-1 .4-2.1.6-3.2.6-4.7 0-8.3-3.8-8.3-8.4 0-1.2.2-2.3.7-3.3C5.4 4.6 3 7.8 3 11.6c0 5 4.1 9.2 9.2 9.2 3.4 0 6.3-1.9 7.9-4.6"/>
      </svg>
      <!-- sun: shown in dark mode -->
      <svg class="sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M12.2 7.6c-2.5-.2-4.6 1.8-4.7 4.3-.1 2.5 1.9 4.5 4.3 4.6 2.5.1 4.6-1.8 4.7-4.3.1-2.4-1.8-4.4-4.3-4.6"/>
        <path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sys = matchMedia('(prefers-color-scheme: dark)');
  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (sys.matches ? 'dark' : 'light');
  const label = () => btn?.setAttribute('aria-label', current() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  label();
  sys.addEventListener('change', label);
  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.classList.add('theme-fade');
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => { m.content = next === 'dark' ? '#151412' : '#F7F3EB'; });
    label();
    setTimeout(() => root.classList.remove('theme-fade'), 320);
  });
</script>

<style>
  .site-header {
    height: var(--header-h);
    background: linear-gradient(to right, transparent calc(var(--margin-x) - 1px), var(--margin-line) calc(var(--margin-x) - 1px), var(--margin-line) var(--margin-x), transparent var(--margin-x)), var(--paper);
    display: flex; align-items: center; justify-content: space-between;
    position: relative; z-index: 2;
    border-bottom: 1px solid var(--rule-strong);
  }
  .mark {
    font-family: var(--hand); font-weight: 600; font-size: 56px; line-height: 1;
    text-decoration: none; color: var(--ink);
    margin-top: -6px; letter-spacing: -0.01em;
    display: inline-flex; align-items: center; min-height: 48px; padding-right: 8px;
  }
  .right { display: flex; align-items: center; gap: 32px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 48px; }
  nav a, nav button {
    font-size: 18px; color: var(--ink); background: none; border: 0; padding: 0;
    cursor: pointer; display: inline-flex; align-items: center; min-height: 44px;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1.5px; background-repeat: no-repeat; background-position: 0 calc(100% - 8px);
  }
  @media (hover: hover) { nav a:hover, nav button:hover { background-size: 100% 1.5px; } }

  .theme {
    width: 44px; height: 44px; margin-right: -10px; display: grid; place-items: center;
    border: 0; border-radius: 999px; background: none; color: var(--ink); cursor: pointer;
    transition: background 150ms var(--ease-ui), transform 160ms var(--ease-ui);
  }
  .theme:active { transform: scale(0.92); }
  @media (hover: hover) { .theme:hover { background: var(--placeholder); } }
  .theme svg { grid-area: 1 / 1; transition: opacity 200ms var(--ease-ui), transform 320ms var(--ease-focal); }
  .sun { opacity: 0; transform: rotate(-60deg) scale(0.7); }
  :global([data-theme="dark"]) .sun { opacity: 1; transform: none; }
  :global([data-theme="dark"]) .moon { opacity: 0; transform: rotate(40deg) scale(0.7); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun { opacity: 1; transform: none; }
    :global(:root:not([data-theme="light"])) .moon { opacity: 0; transform: rotate(40deg) scale(0.7); }
  }

  @media (max-width: 720px) {
    .mark { font-size: 44px; }
    .right { gap: 12px; }
    ul { gap: 24px; }
    nav a, nav button { font-size: 17px; }
  }
</style>
