---
// The hand-drawn blue underline used for the active nav item and the active filter.
// Same pen, weight and drawing motion as the circle around "everyone.".
---
<svg class="pen-stroke" viewBox="0 0 40 6" preserveAspectRatio="none" aria-hidden="true">
  <path pathLength="1" d="M1.2 3.9C9.5 2.4 22.4 1.9 38.8 3.1" />
</svg>

<style is:global>
  .pen-stroke {
    position: absolute; left: -2px; right: -2px; bottom: 4px;
    width: calc(100% + 4px); max-width: none; height: 7px;
    overflow: visible; pointer-events: none;
  }
  .pen-stroke path {
    /* no non-scaling-stroke: Chrome then measures the dash in screen pixels and leaves
       stray fragments; the line is near-horizontal, so only the 7/6 vertical scale matters */
    fill: none; stroke: var(--pen); stroke-width: 1.9; stroke-linecap: round;
    stroke-dasharray: 1 2; stroke-dashoffset: 1.02;
    /* erasing is quick and quiet; drawing uses the focal curve */
    transition: stroke-dashoffset 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .is-inked > .pen-stroke path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* on page load the current item's stroke draws in once, like the circle */
  .pen-draw-in > .pen-stroke path { animation: pen-stroke-in 520ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both; }
  @keyframes pen-stroke-in { from { stroke-dashoffset: 1.02; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .pen-stroke path, .is-inked > .pen-stroke path { transition: none; }
    .pen-draw-in > .pen-stroke path { animation: none; }
  }
</style>
