---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer wrap">
  <p class="sign">Say hello — <button type="button" class="link" data-open-contact>write to me</button></p>
  <div class="meta">
    <span>{site.city}, <time data-clock>EAT</time></span>
    <a class="link" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
    <span>© {year} CJ</span>
  </div>
</footer>

<script>
  const el = document.querySelector<HTMLTimeElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Nairobi' });
    const tick = () => { el.textContent = `${fmt.format(new Date())} EAT`; };
    tick(); setInterval(tick, 30_000);
  }
</script>

<style>
  .site-footer {
    display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 16px 48px;
    padding-top: 72px; padding-bottom: 72px;
    border-top: 1px solid var(--rule-strong);
  }
  .sign { margin: 0; font-size: 28px; line-height: 1.3; letter-spacing: -0.01em; }
  .sign button { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; color: var(--pen); background-image: linear-gradient(currentColor, currentColor); background-size: 100% 1.5px; background-repeat: no-repeat; background-position: 0 100%; }
  .meta { display: flex; gap: 32px; flex-wrap: wrap; color: var(--pencil); font-size: 16px; }
  .meta a { color: var(--pencil); }
  time { font-variant-numeric: tabular-nums; }
  @media (max-width: 720px) { .sign { font-size: 24px; } .meta { gap: 20px; } }
</style>
