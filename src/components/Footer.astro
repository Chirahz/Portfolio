---
import { site } from '../data/site';
---
<footer class="site-footer wrap">
  <p class="sig">CJ — UX · {site.city}, <time data-clock>EAT</time></p>
  <ul class="links">
    <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
    <li><a class="link" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
    <li><a class="link" href="/#work">All projects</a></li>
    <li><a class="link" href="#top" data-top>Back to top ↑</a></li>
  </ul>
</footer>

<script>
  import { onPage } from '../scripts/page';
  onPage((signal) => {
    const el = document.querySelector<HTMLTimeElement>('[data-clock]');
    if (el) {
      const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Nairobi' });
      const tick = () => { el.textContent = fmt.format(new Date()); };
      tick();
      const iv = setInterval(tick, 30_000);
      signal.addEventListener('abort', () => clearInterval(iv));
    }
    document.querySelector('[data-top]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (window.lenis && !reduce) window.lenis.scrollTo(0, { duration: 1.4 }); else scrollTo({ top: 0 });
      (document.querySelector('.mark') as HTMLElement | null)?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .site-footer {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 40px;
    padding-top: 48px; padding-bottom: 56px;
  }
  .sig { margin: 0; font-size: 16px; font-weight: 560; }
  time { font-weight: 400; color: var(--pencil); font-variant-numeric: tabular-nums; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 32px; font-size: 16px; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); background-position: 0 calc(100% - 10px); }
  .links li:first-child a { color: var(--pencil); }
  @media (max-width: 720px) {
    .site-footer { flex-direction: column; align-items: flex-start; padding-top: 32px; }
    .links { gap: 0 24px; }
  }
</style>
